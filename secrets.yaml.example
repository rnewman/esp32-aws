# Copy to secrets.yaml and fill in.
wifi_ssid: "your-network"
wifi_password: "your-wifi-password"
# Password for the fallback hotspot the device starts if it can't join WiFi.
wifi_ap_password: "fallback-hotspot-password"
# 32-byte base64 key for the Home Assistant API; generate with: openssl rand -base64 32
api_encryption_key: "..."
ota_password: "your-ota-password"
